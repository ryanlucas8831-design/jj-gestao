  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A0F18",
  "theme_color": "#0A0F18",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Lançar o dia", "url": "./#hoje", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "Quanto eu devo", "url": "./#devo", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]}
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{"name": "comprovante", "accept": ["image/*", "application/pdf", ".pdf", ".jpg", ".jpeg", ".png", ".webp"]}]
    }
  }
